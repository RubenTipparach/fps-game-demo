  "animations": {
    "_comment": "Every clip is a seamless loop (first key = last key). The walk plays in place: the root never moves, and the planted foot slides back at speed_m_s, so moving the character at that speed keeps the feet still on the ground.",
    "fps": 30,
    "idle": {"length_s": 4.0, "loop": true, "breath_deg": 1.6, "sway_m": 0.012, "sway_roll_deg": 1.5, "knee_drop_m": 0.008,
             "head_turn_deg": 20.0, "head_turn_s": [1.1, 1.7, 2.6, 3.3], "elbow_deg": 8.0},
    "walk": {"loop": true, "speed_m_s": 1.4, "cycle_s": 1.1, "stance_fraction": 0.5, "front_fraction": 0.4, "step_width": 0.85,
             "foot_lift_m": 0.09, "heel_strike_deg": 12.0, "heel_peel_deg": 32.0, "peel_fraction": 0.3, "knee_margin_m": 0.012,
             "hip_yaw_deg": 5.0, "hip_roll_deg": 3.5, "hip_sway_m": 0.018, "lean_deg": 3.0, "arm_swing_deg": 18.0,
             "elbow_deg": [10.0, 30.0]},
    "talk": {"length_s": 3.0, "loop": true, "nod_deg": 6.0, "turn_deg": 5.0, "sway_m": 0.01, "gesture_deg": 22.0,
             "elbow_deg": 70.0, "twist_deg": 35.0},
    "guard": {"length_s": 4.0, "loop": true, "stance_widen_m": 0.07, "breath_deg": 1.8, "scan_deg": 22.0, "knee_drop_m": 0.012},
    "sit": {"length_s": 1.0, "loop": true, "seat_height_m": 0.45, "slouch_deg": 10.0},
    "holds": {
      "_comment": "Arm poses that replace the clip's arm keys while a prop is held: degrees about armature X, Y, Z (negative X swings an arm forward).",
      "umbrella": {"upperarm_r": [-28.0, 8.0, 0.0], "forearm_r": [-100.0, 0.0, 0.0], "hand_r": [0.0, 0.0, 0.0]}
    }
  },
